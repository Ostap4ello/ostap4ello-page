---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../lib/urls';
---

<SiteLayout title="O. — Portfolio and notes" active="home">
  <section class="max-w-3xl">
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-[var(--text-subtle)]">Hello</p>
    <h1 class="mt-5 text-2xl font-semibold tracking-tight text-[var(--text)] sm:text-3xl">Portfolio, notes, and experiments.</h1>
    <p class="mt-6 max-w-2xl text-base leading-7 text-[var(--text-muted)]">
      A minimal home for selected work and an evolving collection of things worth remembering.
    </p>
    <div class="mt-8 flex flex-wrap gap-4 text-sm">
      <a class="rounded-sm bg-[var(--accent)] px-5 py-3 font-medium text-white transition hover:bg-[var(--accent-strong)]" href={withBase('docs')}>Read the docs</a>
      <a class="rounded-sm border border-[var(--border-strong)] px-5 py-3 font-medium text-[var(--text)] transition hover:border-[var(--accent)] hover:text-[var(--accent)]" href={withBase('about')}>About me</a>
    </div>
  </section>
</SiteLayout>
