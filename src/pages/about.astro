---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="About me — O." active="about">
  <section class="max-w-2xl">
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-[var(--text-subtle)]">About me</p>
    <h1 class="mt-5 text-2xl font-semibold tracking-tight text-[var(--text)] sm:text-3xl">Ostap Pelekh</h1>
    <p class="mt-4 text-base leading-7 text-[var(--text-muted)]">
      Experienced Linux user and software engineer with commercial experience, passionate about optimizing workflows and automating tasks. Currently studying Mathematical Modelling in Physics and Technology at Charles University and focused on AI, LLMs, and their applications.
    </p>
    <p class="mt-4 text-base leading-7 text-[var(--text-muted)]">
      I constantly explore new technologies, programming languages, and computer science concepts. I am also interested in reading, music creation, and open-source projects, particularly in the AI space.
    </p>

    <dl class="mt-8 grid gap-4 border-t border-[var(--border)] pt-6 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-medium text-[var(--text)]">Location</dt>
        <dd class="mt-1 text-[var(--text-muted)]">Prague, Czechia / Bratislava, Slovakia</dd>
      </div>
      <div>
        <dt class="font-medium text-[var(--text)]">Languages</dt>
        <dd class="mt-1 text-[var(--text-muted)]">Ukrainian, English, Slovak, German, French</dd>
      </div>
      <div>
        <dt class="font-medium text-[var(--text)]">Email</dt>
        <dd class="mt-1"><a class="text-[var(--accent)]" href="mailto:okpeleh@gmail.com">okpeleh@gmail.com</a></dd>
      </div>
      <div>
        <dt class="font-medium text-[var(--text)]">Phone</dt>
        <dd class="mt-1"><a class="text-[var(--accent)]" href="tel:+421950491139">+421 950 491 139</a></dd>
      </div>
      <div>
        <dt class="font-medium text-[var(--text)]">LinkedIn</dt>
        <dd class="mt-1"><a class="text-[var(--accent)]" href="https://www.linkedin.com/in/ostap-pelekh">ostap-pelekh</a></dd>
      </div>
      <div>
        <dt class="font-medium text-[var(--text)]">GitHub</dt>
        <dd class="mt-1"><a class="text-[var(--accent)]" href="https://github.com/Ostap4ello">Ostap4ello</a></dd>
      </div>
    </dl>

    <section class="mt-10">
      <h2 class="text-base font-semibold text-[var(--text)]">Experience</h2>
      <div class="mt-4 border-l border-[var(--border)] pl-5">
        <h3 class="font-medium text-[var(--text)]">Software Engineer Intern — Nokia</h3>
        <p class="mt-1 text-sm text-[var(--text-subtle)]">June 2025 – Present · Bratislava, Slovakia</p>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-[var(--text-muted)]">
          <li>Contributed to and debugged a large C/C++ codebase.</li>
          <li>Built internal tools that improved team workflows and productivity.</li>
          <li>Collaborated across teams to deliver reliable changes.</li>
          <li>Used AI tools to improve development efficiency and automate work.</li>
        </ul>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-base font-semibold text-[var(--text)]">Education</h2>
      <div class="mt-4 grid gap-4 text-sm">
        <div>
          <h3 class="font-medium text-[var(--text)]">Charles University</h3>
          <p class="mt-1 text-[var(--text-muted)]">M.Sc. Mathematical Modelling in Physics and Technology · September 2026 – July 2029</p>
        </div>
        <div>
          <h3 class="font-medium text-[var(--text)]">Slovak University of Technology in Bratislava</h3>
          <p class="mt-1 text-[var(--text-muted)]">B.Sc. Candidate in Information Technology · September 2023 – Present</p>
          <p class="mt-1 text-sm leading-6 text-[var(--text-muted)]">Among the top 2% of students in the study program by average score. Acquired theoretical knowledge across computer science fields.</p>
        </div>
        <div>
          <h3 class="font-medium text-[var(--text)]">Lviv Physics and Mathematics Lyceum</h3>
          <p class="mt-1 text-[var(--text-muted)]">Physics and Mathematics · 2019 – 2023</p>
          <p class="mt-1 text-sm leading-6 text-[var(--text-muted)]">Specialized in mathematics and physics and completed secondary education required for university admission.</p>
        </div>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-base font-semibold text-[var(--text)]">Skills</h2>
      <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2">
        <div>
          <dt class="font-medium text-[var(--text)]">Technologies</dt>
          <dd class="mt-2 leading-6 text-[var(--text-muted)]">C/C++ · Python · Java · Bash · Linux · Docker · Git · FastAPI · SQL/NoSQL databases · Vector databases · Ollama · OpenAI API · Arduino · Raspberry Pi · Markdown · LaTeX</dd>
        </div>
        <div>
          <dt class="font-medium text-[var(--text)]">Knowledge</dt>
          <dd class="mt-2 leading-6 text-[var(--text-muted)]">LLMs · RNN · LSTM · CNN · MLP · RAG · Agents · Transformers · Attention · Operating systems · Computer architecture · Data structures · Algorithms · Networking · Software engineering · Mathematics · Physics</dd>
        </div>
      </dl>
    </section>

    <section class="mt-10">
      <h2 class="text-base font-semibold text-[var(--text)]">Languages</h2>
      <p class="mt-3 text-sm leading-6 text-[var(--text-muted)]">
        Ukrainian — Native · English — B2/C1 · Slovak — B2/C1 · German — A1 · French — A1
      </p>
    </section>
  </section>
</SiteLayout>
