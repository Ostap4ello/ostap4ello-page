---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="About me — O." active="about">
  <section class="max-w-2xl">
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-[var(--text-subtle)]">About me</p>
    <h1 class="mt-5 text-2xl font-semibold tracking-tight text-[var(--text)] sm:text-3xl">A quiet place for work and notes.</h1>
    <p class="mt-6 max-w-xl text-base leading-7 text-[var(--text-muted)]">
      Add a short introduction here: what you build, what you are learning, and where people can find you.
    </p>
  </section>
</SiteLayout>
