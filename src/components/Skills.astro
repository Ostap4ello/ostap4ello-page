---
export interface SkillGroup {
  label: string;
  items: string[];
}

interface Props {
  groups: SkillGroup[];
  mode?: 'normal' | 'small';
}

const { groups, mode = 'normal' } = Astro.props;
---

<dl
  class:list={[
    'not-prose grid gap-3',
    mode === 'normal' ? 'text-base sm:grid-cols-2' : 'text-xs sm:grid-cols-2'
  ]}
>
  {groups.map((group) => (
    <div class:list={[
      'border-l-[4px] border-[var(--divider)] pl-4',
      mode === 'small' && 'opacity-90'
    ]}>
      <dt class="font-semibold text-[var(--text)]">{group.label}</dt>
      <dd class="mt-1 leading-6 text-[var(--text-muted)]">
        {group.items.join(' · ')}
      </dd>
    </div>
  ))}
</dl>
