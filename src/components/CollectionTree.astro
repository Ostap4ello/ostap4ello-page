---
import { withBase } from '../lib/urls';
import type { CollectionName } from '../types';
import type { ContentTreeNode } from '../lib/content';

interface Props {
  collection: CollectionName;
  nodes: ContentTreeNode[];
}

const { collection, nodes } = Astro.props;
---

<nav aria-label={`${collection} contents`}>
  <ul class="space-y-2">
    {nodes.map((node) => (
      <li>
        {node.kind === 'folder' ? (
          <details open class="group">
            <summary class="cursor-pointer list-none rounded-sm px-2 py-1 text-sm font-medium text-[var(--text-muted)] transition hover:bg-[var(--surface-muted)] hover:text-[var(--text)]">
              <span class="mr-2 text-[var(--accent)]">▾</span>{node.name}
            </summary>
            <div class="ml-4 border-l border-[var(--border)] pl-3 pt-1">
              <Astro.self collection={collection} nodes={node.children} />
            </div>
          </details>
        ) : (
          <a
            class="block rounded-sm px-2 py-1.5 text-sm text-[var(--text-muted)] transition hover:bg-[var(--surface-muted)] hover:text-[var(--accent)]"
            href={withBase(`${collection}/${node.entry.id}`)}
          >
            {node.name}
          </a>
        )}
      </li>
    ))}
  </ul>
</nav>
