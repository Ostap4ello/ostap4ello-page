---
import type { CollectionName, ContentEntry } from '../types';
import { titleForEntry } from '../lib/content';
import { withBase } from '../lib/urls';

interface Props {
  collection: CollectionName;
  entries: ContentEntry[];
}

const { collection, entries } = Astro.props;
---

<div class="grid gap-4">
  {entries.length === 0 ? (
    <p class="text-[var(--text-muted)]">No entries yet.</p>
  ) : (
    entries.map((entry) => (
      <a
        class="group rounded-sm border border-[var(--border)] bg-[var(--surface)] p-5 transition hover:border-[var(--accent)]"
        href={withBase(`${collection}/${entry.id}`)}
      >
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="font-medium text-[var(--text)] group-hover:text-[var(--accent)]">{titleForEntry(entry)}</h2>
          <span class="font-mono text-xs text-[var(--text-subtle)]">{entry.id}</span>
        </div>
        {entry.data.description && <p class="mt-2 text-sm leading-6 text-[var(--text-muted)]">{entry.data.description}</p>}
      </a>
    ))
  )}
</div>
