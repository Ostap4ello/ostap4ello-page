---
import '../styles/global.css';
import { withBase } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'about' | 'docs' | 'misc';
}

const { title, description = 'A small personal site and notebook.', active } = Astro.props;
const links = [
  { label: 'Home', href: '/', key: 'home' },
  { label: 'About me', href: '/about', key: 'about' },
  { label: 'Docs', href: '/docs', key: 'docs' },
  { label: 'Misc', href: '/misc', key: 'misc' }
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : systemTheme;
    </script>
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[var(--background)] text-[var(--text)] antialiased">
    <header class="sticky top-0 z-20 border-b border-[var(--border)] bg-[var(--background)]">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-5 sm:px-8" aria-label="Main navigation">
        <div class="flex items-center gap-3">
          <a class="text-lg font-semibold tracking-tight text-[var(--text)]" href={withBase()} aria-label="Ostap Pelekh home">OP</a>
          <button
            type="button"
            class="flex size-8 items-center justify-center rounded-sm text-base leading-none transition hover:text-[var(--accent)]"
            data-theme-toggle
            aria-label="Current theme: system. Activate to switch theme."
          >
            <span aria-hidden="true" data-theme-icon>◐</span>
          </button>
        </div>
        <div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-2 text-sm text-[var(--text-muted)]">
          {links.map((link) => (
            <a
              class:list={[
                'transition hover:text-[var(--accent)]',
                active === link.key && 'text-[var(--text)]'
              ]}
              href={withBase(link.href)}
              aria-current={active === link.key ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
        </div>
      </nav>
    </header>
    <main class="mx-auto flex w-full max-w-6xl justify-center px-5 py-12 sm:px-8 sm:py-16">
      <slot />
    </main>
    <footer class="text-center mx-auto max-w-6xl px-5 pb-10 text-sm text-[var(--text-subtle)] sm:px-8">
      <p>Note: this page was violently and shamelessly vibecoded by free (student) plan of GH Copilot.</p>
      <p>Built with Astro.</p>
    </footer>
    <script is:inline>
      const themeButton = document.querySelector('[data-theme-toggle]');
      const themeIcon = document.querySelector('[data-theme-icon]');
      const getTheme = () => document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      const updateThemeButton = () => {
        if (themeButton) {
          const theme = getTheme();
          themeButton.setAttribute('aria-label', `Current theme: ${theme}. Activate to switch theme.`);
          themeButton.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
        }
        if (themeIcon) themeIcon.textContent = getTheme() === 'dark' ? '☀' : '☾';
      };
      themeButton?.addEventListener('click', () => {
        const nextTheme = getTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem('theme', nextTheme);
        updateThemeButton();
      });
      updateThemeButton();
    </script>
  </body>
</html>
